@model ProductVariantUpdateViewModel

<div id="main-content" class="h-full w-full bg-gray-50 relative overflow-y-auto lg:ml-64">
    <main>
        <br />
        <div class="relative w-full max-w-2xl px-4 h-full md:h-auto">
            <!-- Modal content -->
            <div class="bg-white rounded-lg shadow relative">
                <!-- Modal header -->
                <div class="flex items-start justify-between p-5 border-b rounded-t">
                    <h3 class="text-xl font-semibold">
                        Edit
                    </h3>
                    <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 ml-auto inline-flex items-center" data-modal-toggle="add-product-modal">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                    </button>
                </div>
                <!-- Modal body -->
                <div class="p-6 space-y-6">
                    <form method="post" enctype="multipart/form-data">
                        <div class="grid grid-cols-6 gap-6">
                            <div class="col-span-6 sm:col-span-3">
                                <label class="text-sm font-medium text-gray-900 block mb-2">Product</label>
                                <select asp-for="ProductId" asp-items="Model.ProductSelectListItems" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Category"></select>
                                <span asp-validation-for="ProductId"></span>
                            </div>
                            <div class="col-span-6 sm:col-span-3">
                                <label class="text-sm font-medium text-gray-900 block mb-2">Product Price</label>
                                <input asp-for="Price" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Price">
                                <span asp-validation-for="Price"></span>
                            </div>

                            <div class="col-span-6 sm:col-span-3">
                                <label class="text-sm font-medium text-gray-900 block mb-2">Color</label>
                                <select asp-for="ColorId" asp-items="Model.ColorSelectListItems" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Category"></select>
                                <span asp-validation-for="ColorId"></span>
                            </div>
                            <div class="col-span-6 sm:col-span-3">
                                <label class="text-sm font-medium text-gray-900 block mb-2">Quantity</label>
                                <input asp-for="Quantity" class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5" placeholder="Price">
                                <span asp-validation-for="Quantity"></span>
                            </div>
                            <div class="col-span-6 sm:col-span-3">
                                <label class="text-sm font-medium text-gray-900 block mb-2"> Cover Image</label>
                                <input name="CoverImageName" value="@Model.CoverImageName" type="hidden" />
                                <img src="~/images/products/@Model.CoverImageName" width="100" height="100" />
                                <br/>
                                <input asp-for="CoverImageFile"
                                       class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5"
                                       placeholder="Image" accept="image/*">
                                <span asp-validation-for="CoverImageFile"></span>
                            </div>
                            <div class="col-span-6 sm:col-span-3">
                                <label class="text-sm font-medium text-gray-900 block mb-2">Images</label>
                                @foreach (var item in Model.ProductImages)
                                {
                                    <div style="display:inline-block">
                                        <img src="~/images/products/@item.ImageName" width="100" height="100" />
                                        <span onclick="deleteImage(@item.Id, this)">Delete</span>
                                    </div>
                                }                 
                                <br/>
                                <br/>
                                <input asp-for="ImageFiles"
                                       class="shadow-sm bg-gray-50 border border-gray-300 text-gray-900 sm:text-sm rounded-lg focus:ring-cyan-600 focus:border-cyan-600 block w-full p-2.5"
                                       placeholder="Image" accept="image/*">
                                <span asp-validation-for="ImageFiles"></span>
                            </div>

                            <br />
                        </div>
                        <br />
                        <div asp-validation-summary="All"></div>
                        <button class="text-white bg-cyan-600 hover:bg-cyan-700 focus:ring-4 focus:ring-cyan-200 font-medium rounded-lg text-sm px-5 py-2.5 text-center" type="submit">Save</button>
                    </form>
                </div>


            </div>
        </div>
    </main>

    <script>
            function deleteImage(id, element){
            fetch(`/Admin/ProductVariant/deleteProductImage/${id}`,{
                method : "Post"}).
                then(response=>response.json()).
                then(data =>{
                    console.log(data);
                    if (data.isDeleted == true)
                        element.parentNode.remove();
                  }).catch(error => {});
        }
    </script>
