    </main>

<script>
    function deleteProductImage(id, element){
        fetch(`https://localhost:7108/Admin/Product/deleteProductImage/${id}`,{
            method:"Post"
        }).
        then(response=>response.json()).
        then(data=>{
            element.parentNode.remove();
        }).catch(error=>{
            console.log('Error', error);
        });
    }
</script>
